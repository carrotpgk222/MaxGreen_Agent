# MaxGreen Agent configuration.
#
# Copy to .env and fill in the LLM gateway values. Real values live only in .env,
# which is git-ignored. Every key below is read by the code; every key the code reads
# is listed here.

# ---------- LLM gateway (required for classification and document pre-fill) ----------
# Ollama-compatible chat endpoint provided by the organizer. The backend posts to
# {LLM_GATEWAY_URL}/api/chat with the key in an x-api-key header.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=

# ---------- Gmail sync ----------
# Gmail query used by both the background scheduler and the manual Sync button.
GMAIL_SYNC_QUERY=in:inbox

# Default page size for the manual sync endpoint. Bounded to 1-100 by the API.
GMAIL_SYNC_LIMIT=25

# ---------- Background poll loop (scheduler_service) ----------
# How often the backend syncs with no browser tab open. Floor is 5 seconds.
GMAIL_POLL_INTERVAL_SECONDS=30
# Messages fetched per poll tick. Clamped to 1-100.
GMAIL_POLL_LIMIT=10

# ---------- Automatic classification (sync_service) ----------
# Send newly synced Unclassified messages to Claude automatically. Set to false to
# classify only from the Inbox button.
GMAIL_AUTO_CLASSIFY=true
# Safety/cost cap: at most this many messages are classified per sync.
GMAIL_AUTO_CLASSIFY_LIMIT=25
