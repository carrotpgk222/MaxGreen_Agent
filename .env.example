# Local-only settings for now.
GMAIL_SYNC_QUERY=in:inbox
GMAIL_SYNC_LIMIT=25
GMAIL_AUTO_SYNC=false
GMAIL_SYNC_INTERVAL_SECONDS=60

# Organizer-provided LLM gateway. Keep real values only in .env (never GitHub).
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=

# Automatically send newly synced Unclassified Gmail records to Claude.
GMAIL_AUTO_CLASSIFY=true
# Safety/cost cap per Gmail sync.
GMAIL_AUTO_CLASSIFY_LIMIT=25
